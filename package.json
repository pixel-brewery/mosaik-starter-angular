{
  "name": "mosaik-starter-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An independent Angular starter for Mosaik web components.",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "ng serve --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false",
    "build": "ng build",
    "preview": "http-server dist/mosaik-starter-angular/browser -a 127.0.0.1 -p 4173 -c-1"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@pixel-brewery/mosaik-elements-angular": "0.1.179",
    "@pixel-brewery/mosaik-elements-foundation": "0.1.179",
    "@pixel-brewery/mosaik-icons": "0.1.179",
    "@pixel-brewery/mosaik-themes": "0.1.179",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "http-server": "14.1.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
